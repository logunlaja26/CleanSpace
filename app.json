{
  "expo": {
    "name": "CleanSpace",
    "slug": "cleanspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cleanspace-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lyomann.cleanspace",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "CleanSpace needs access to your photo library to help you organize and clean up duplicate photos, large files, and screenshots to free up storage space.",
        "NSPhotoLibraryAddUsageDescription": "CleanSpace needs permission to save optimized photos back to your library after compression.",
        "NSCameraUsageDescription": "CleanSpace may use your camera to capture new photos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lyomann.cleanspace",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow CleanSpace to access your photos to analyze and help you clean up duplicates, large files, and screenshots.",
          "savePhotosPermission": "Allow CleanSpace to save optimized photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e9a5a19c-df48-4905-9dc9-88bc3b92ce79"
      }
    },
    "owner": "lyomann"
  }
}
